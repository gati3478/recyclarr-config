#!/bin/sh
# Scores the release titles in releases.tsv with Radarr's and Sonarr's own
# matcher against their live profiles on the box, and checks each row. It
# tests what the *arrs hold, so run it after a sync, not after an edit.
case "${1:-}" in
  -h|--help) echo "usage: tests/scores [TABLE] — checks TABLE, default tests/releases.tsv, on the box (ssh whatbox); exit 0 all pass, 1 a row failed or none ran, 2 TABLE unreadable"; exit 0 ;;
esac
set -eu
here="$(cd "$(dirname "$0")" && pwd)"
table="${1:-$here/releases.tsv}"
[ -r "$table" ] && [ ! -d "$table" ] || { echo "tests/scores: cannot read $table" >&2; exit 2; }
# The table travels inside the program as a string literal: JSON's string
# syntax is valid Python, and nothing is written on the box.
data="$(python3 -I -c '
import json, sys
try:
    print(json.dumps(open(sys.argv[1], encoding="utf-8").read()))
except UnicodeDecodeError as e:
    print(f"tests/scores: cannot read {sys.argv[1]}: {e}", file=sys.stderr)
    sys.exit(2)' "$table")"
{ cat "$here/scores.py"; printf '\nmain(%s)\n' "$data"; } | ssh whatbox python3 -
